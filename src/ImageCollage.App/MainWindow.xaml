<Window x:Class="ImageCollage.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="戌無图片拼图" Width="1240" Height="780" MinWidth="980" MinHeight="640" Background="#F3F5F7"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="#DFE3E8" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,10">
                <StackPanel Orientation="Horizontal">
                    <Button Content="＋ 添加图片" Click="AddImages_Click" Background="{StaticResource AccentBrush}" Foreground="White"/>
                    <Button Content="移除" Click="Remove_Click"/><Button Content="清空列表" Click="Clear_Click"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="↑ 上移" Click="MoveUp_Click"/><Button Content="↓ 下移" Click="MoveDown_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#DFE3E8" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,14,14,8">
                        <TextBlock Text="图片列表" FontWeight="Bold" FontSize="15"/>
                        <TextBlock Text="最多 6 张 · 拖入图片或文件夹" Foreground="#7B8590" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="PhotoList" ItemsSource="{Binding Photos}" SelectionMode="Single" BorderThickness="0">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Grid Margin="5" Width="215">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Width="52" Height="52" CornerRadius="7" ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/></Border>
                                <StackPanel Grid.Column="1" Margin="9,4,0,0">
                                    <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Dimensions}" Foreground="#7B8590" FontSize="11" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1" x:Name="PreviewHost" Background="#E7EAEE">
                <Border Margin="30" Background="#D8DDE4" CornerRadius="5">
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="20"/>
                </Border>
                <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="＋" FontSize="42" Foreground="#8A95A1" HorizontalAlignment="Center"/>
                    <TextBlock Text="把图片或文件夹拖到这里" FontSize="19" Foreground="#68727D"/>
                    <TextBlock Text="支持 JPG、PNG、WebP、BMP、TIFF" FontSize="11" Foreground="#8A95A1" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </StackPanel>
            </Grid>
            <Border Grid.Column="2" Background="White" BorderBrush="#DFE3E8" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="拼图设置" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="画布比例" Foreground="#707A85" Margin="0,15,0,0"/>
                    <ComboBox x:Name="RatioCombo" SelectionChanged="Setting_Changed">
                        <ComboBoxItem Content="3 : 4（竖向）" Tag="3:4"/><ComboBoxItem Content="1 : 1（方形）" Tag="1:1"/>
                        <ComboBoxItem Content="9 : 16（竖向）" Tag="9:16"/><ComboBoxItem Content="2 : 3（竖向）" Tag="2:3"/>
                        <ComboBoxItem Content="4 : 3（横向）" Tag="4:3"/><ComboBoxItem Content="3 : 2（横向）" Tag="3:2"/>
                        <ComboBoxItem Content="16 : 9（横向）" Tag="16:9"/>
                    </ComboBox>
                    <TextBlock Text="布局模板" Foreground="#707A85"/>
                    <ComboBox x:Name="TemplateCombo" DisplayMemberPath="Name" SelectionChanged="Setting_Changed"/>
                    <TextBlock Text="间隙" Foreground="#707A85"/>
                    <DockPanel><TextBlock Text="{Binding ElementName=GapSlider,Path=Value,StringFormat={}{0:F0} px}" DockPanel.Dock="Right" Width="55" TextAlignment="Right"/>
                        <Slider x:Name="GapSlider" Minimum="0" Maximum="80" ValueChanged="Setting_Changed"/></DockPanel>
                    <TextBlock Text="圆角" Foreground="#707A85"/>
                    <DockPanel><TextBlock Text="{Binding ElementName=RadiusSlider,Path=Value,StringFormat={}{0:F0} px}" DockPanel.Dock="Right" Width="55" TextAlignment="Right"/>
                        <Slider x:Name="RadiusSlider" Minimum="0" Maximum="80" ValueChanged="Setting_Changed"/></DockPanel>
                    <TextBlock Text="背景颜色" Foreground="#707A85"/>
                    <Grid Margin="0,5,0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="BackgroundBox" Height="34" Padding="8" TextChanged="Setting_Changed" VerticalContentAlignment="Center"/>
                        <Border Grid.Column="1" x:Name="BackgroundSwatch" Margin="8,2,0,2" CornerRadius="5" BorderBrush="#CFD5DC" BorderThickness="1"/>
                    </Grid>
                    <Separator/>
                    <TextBlock Text="导出设置" FontSize="15" FontWeight="Bold" Margin="0,17,0,8"/>
                    <TextBlock Text="长边尺寸" Foreground="#707A85"/>
                    <ComboBox x:Name="LongEdgeCombo" SelectedIndex="1">
                        <ComboBoxItem Content="1600 px" Tag="1600"/><ComboBoxItem Content="2400 px" Tag="2400"/><ComboBoxItem Content="3200 px" Tag="3200"/><ComboBoxItem Content="4096 px" Tag="4096"/>
                    </ComboBox>
                    <TextBlock Text="输出格式" Foreground="#707A85"/>
                    <ComboBox x:Name="FormatCombo" SelectedIndex="1"><ComboBoxItem Content="JPG"/><ComboBoxItem Content="PNG"/><ComboBoxItem Content="WebP"/></ComboBox>
                    <TextBlock Text="保存位置" Foreground="#707A85"/>
                    <TextBox x:Name="OutputFolderBox" Height="34" Padding="7" VerticalContentAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="0,7,0,11"><Button Content="选择文件夹…" Click="ChooseFolder_Click"/><Button Content="打开导出位置" Click="OpenOutputFolder_Click"/></StackPanel>
                    <Button x:Name="ExportButton" Content="导出拼图" Height="44" Margin="0,5,0,0" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="Bold" Click="Export_Click" IsEnabled="False"/>
                    <ProgressBar x:Name="ExportProgress" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="ExportStatus" Text="所有图片均在本机处理，原图不会修改。" Foreground="#707A85" FontSize="11" TextWrapping="Wrap" Margin="0,9,0,0"/>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#DFE3E8" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusBarText" Margin="12,7" Foreground="#68727D" FontSize="11" Text="准备就绪 · 导入图片后选择比例和模板"/>
        </Border>
    </Grid>
</Window>
