<Application x:Class="ImageCollage.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#356CF6"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="#E9EDF3"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="34"/><Setter Property="Margin" Value="0,5,0,14"/>
            <Setter Property="Padding" Value="7,3"/>
        </Style>
        <Style TargetType="Slider"><Setter Property="Margin" Value="0,5,0,12"/></Style>
    </Application.Resources>
</Application>
